+/// Finds the user's home directory from an environment lookup
+///
+/// Reads only through `var`, never the process environment. A variable set
+/// to the empty string counts as unset.
+///
+/// - Unix: `HOME`, and nothing else.
+/// - Windows: `HOME`, then `USERPROFILE`, then `HOMEDRIVE` and `HOMEPATH`
+///   concatenated (`C:` and `\Users\name` are two halves of one path), which
+///   counts only when both halves are set.
+///
+/// Returns `None` when nothing resolves.
+#[must_use]
+pub fn user_home(var: &dyn Fn(&str) -> Option<std::ffi::OsString>) -> Option<PathBuf> {
+    let set = |key: &str| var(key).filter(|value| !value.is_empty());
+
+    #[cfg(windows)]
+    {
+        set("HOME")
+            .or_else(|| set("USERPROFILE"))
+            .or_else(|| {
+                let mut joined = set("HOMEDRIVE")?;
+                joined.push(set("HOMEPATH")?);
+                Some(joined)
+            })
+            .map(PathBuf::from)
+    }
+    #[cfg(not(windows))]
+    {
+        set("HOME").map(PathBuf::from)
+    }
+}
