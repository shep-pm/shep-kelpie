+/// Finds the user's home directory from the environment `var` exposes
+///
+/// Reads nothing from the process environment: every variable comes through
+/// `var`, so tests and the daemon share one code path. A variable set to the
+/// empty string counts as unset on every platform.
+///
+/// Unix consults `HOME` alone. Windows tries `HOME`, then `USERPROFILE`,
+/// then `HOMEDRIVE` and `HOMEPATH` joined as one path (`C:` and
+/// `\Users\name` are two halves of a single path); the pair counts only when
+/// both halves are set. Returns `None` when nothing resolves.
+#[must_use]
+pub fn user_home(var: &dyn Fn(&str) -> Option<std::ffi::OsString>) -> Option<PathBuf> {
+    let lookup = |name: &str| var(name).filter(|value| !value.is_empty());
+
+    #[cfg(not(windows))]
+    {
+        lookup("HOME").map(PathBuf::from)
+    }
+
+    #[cfg(windows)]
+    {
+        lookup("HOME")
+            .or_else(|| lookup("USERPROFILE"))
+            .or_else(|| {
+                let mut drive = lookup("HOMEDRIVE")?;
+                drive.push(lookup("HOMEPATH")?);
+                Some(drive)
+            })
+            .map(PathBuf::from)
+    }
+}
