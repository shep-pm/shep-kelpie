+/// Finds the user's home directory from an environment lookup
+///
+/// Reads only through `var`, never the process environment. A variable set
+/// to the empty string counts as unset, on every platform.
+///
+/// Unix: `HOME`, and no other variable.
+///
+/// Windows: the first of `HOME`, `USERPROFILE`, and `HOMEDRIVE` followed by
+/// `HOMEPATH`. The last two are halves of one path (`C:` and `\Users\ada`),
+/// so they are joined into a single string, and the pair counts only when
+/// both are present.
+///
+/// Returns `None` when nothing resolves. The result is not checked against
+/// the filesystem.
+#[must_use]
+pub fn user_home(var: &dyn Fn(&str) -> Option<std::ffi::OsString>) -> Option<PathBuf> {
+    let set = |name: &str| var(name).filter(|value| !value.is_empty());
+    let home = set("HOME");
+    #[cfg(windows)]
+    let home = home.or_else(|| set("USERPROFILE")).or_else(|| {
+        let mut joined = set("HOMEDRIVE")?;
+        joined.push(set("HOMEPATH")?);
+        Some(joined)
+    });
