+/// of the message on that first line, so a newline in it would start a line
+/// this never sees.
 fn indent_continuations(message: &str) -> String {
     let mut out = String::with_capacity(message.len());
     for (n, line) in message.split('\n').enumerate() {
         if n > 0 {
             out.push('\n');
             if !line.is_empty() {
                 out.push_str("  ");
             }
         }
