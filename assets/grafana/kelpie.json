    {
      "id": 22,
      "type": "timeseries",
      "title": "Cache writes by what came before",
      "description": "Tokens an hour that requests wrote to the cache: start is a session's first request, gap is a request after the cache kept what the one before wrote (5 minutes, or 1 hour for Claude Code's 1-hour writes), which rewrites what the cache dropped, and growth is the rest. Claude Code and pi calls only.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 80
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (after) (rate(kelpie_cache_write_tokens_total{sheep=~\"$sheep\"}[1h])) * 3600",
          "legendFormat": "{{after}}"
        }
